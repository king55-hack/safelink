{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safelink",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* runs the Worker first; everything else is served as a static file.
    "run_worker_first": ["/api/*"]
  },
  // Per-IP rate limit for /api/check (10 checks per minute). Counted per Cloudflare location.
  "ratelimits": [
    { "name": "CHECK_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // Custom domain (DNS + certificate are created automatically; the zone must be in this Cloudflare account)
  "routes": [{ "pattern": "safelink.rajanrimal.com.np", "custom_domain": true }],
  "observability": { "enabled": true }
  // Optional secret (never commit it):  npx wrangler secret put SAFE_BROWSING_KEY
}
